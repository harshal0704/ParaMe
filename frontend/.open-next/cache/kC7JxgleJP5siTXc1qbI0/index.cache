{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><!--kC7JxgleJP5siTXc1qbI0--><html lang=\"en\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/8a122402e71e8374.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-3e10a53c71a87ce7.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-fb733a23c0f3e429.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-9e26c05a99ccddfa.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-83fbe5a870940566.js\" async=\"\"></script><script src=\"/_next/static/chunks/18-28e1fe3b6e1bb4df.js\" async=\"\"></script><script src=\"/_next/static/chunks/503-8f08a695dce4c72a.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-15992da3c5001d94.js\" async=\"\"></script><script src=\"https://clerk.hero.dev/npm/@clerk/clerk-js@5/dist/clerk.browser.js\" data-clerk-js-script=\"true\" async=\"\" crossorigin=\"anonymous\" data-clerk-publishable-key=\"pk_test_Y2xlcmsuaGVyby5kZXYk\"></script><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"/><title>Pavtar — Omnichannel AI Persona &amp; 3D Digital Twin</title><meta name=\"description\" content=\"Create your photorealistic 3D digital twin with cloned voice, multimodal memory RAG, and omnichannel WebRTC calling.\"/><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"/><link rel=\"apple-touch-icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"bg-[#070604] text-[#f4efe6] antialiased min-h-screen\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"grain-overlay\" aria-hidden=\"true\"></div><div class=\"flex flex-col min-h-screen bg-[#070604] text-[#f5f1e8] selection:bg-amber-500/30 selection:text-amber-200\"><header class=\"sticky top-0 z-50 backdrop-blur-2xl bg-[#070604]/85 border-b border-white/[0.07] px-6 py-4\"><div class=\"max-w-7xl mx-auto flex items-center justify-between\"><a class=\"flex items-center gap-3.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-amber-200 via-amber-400 to-amber-600 p-[1px] shadow-[0_0_25px_rgba(212,175,55,0.35)] transition-transform duration-300 group-hover:scale-105\"><div class=\"w-full h-full bg-[#070604] rounded-[7px] flex items-center justify-center\"><span class=\"font-display font-extrabold text-amber-300 text-lg leading-none\">P</span></div></div><div class=\"flex items-center gap-2\"><span class=\"font-bold text-base tracking-tight text-white\">Pavtar</span><span class=\"text-[10px] font-mono uppercase tracking-widest px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-300\">v1.0</span></div></a><nav class=\"hidden md:flex items-center gap-8 text-xs font-mono text-stone-400\"><a href=\"#proof\" class=\"hover:text-amber-200 transition-colors\">/proof</a><a href=\"#avatar-engine\" class=\"hover:text-amber-200 transition-colors\">/3d-avatar</a><a href=\"#voice-lab\" class=\"hover:text-amber-200 transition-colors\">/voice-lab</a><a href=\"#omnichannel\" class=\"hover:text-amber-200 transition-colors\">/omnichannel</a><a class=\"text-amber-300 hover:text-amber-200 flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20\" href=\"/u/harshal\"><span class=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\"></span><span>/u/harshal (Free Demo)</span></a></nav><div class=\"flex items-center gap-3\"><a class=\"ks-button-ghost text-xs hidden sm:inline-flex\" href=\"/sign-in\">Sign In</a><a class=\"ks-button-primary text-xs\" href=\"/sign-up\"><span>Launch Studio Free</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-3.5 h-3.5\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></header><section class=\"relative pt-24 pb-20 px-6 overflow-hidden\"><div class=\"absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[450px] bg-gradient-to-b from-amber-500/15 via-amber-600/5 to-transparent blur-[160px] pointer-events-none -z-10\"></div><div class=\"max-w-5xl mx-auto text-center space-y-8\"><div class=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#14120e] border border-amber-500/30 text-xs font-mono text-amber-300 shadow-[0_0_20px_rgba(212,175,55,0.15)]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles w-3.5 h-3.5 text-amber-400\"><path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"></path><path d=\"M20 3v4\"></path><path d=\"M22 5h-4\"></path><path d=\"M4 17v2\"></path><path d=\"M5 18H3\"></path></svg><span>Sub-450ms Full-Duplex WebRTC • ARKit 52 Blendshapes • $0 Cloud Stack</span></div><h1 class=\"text-5xl md:text-7xl font-bold tracking-tight text-white max-w-4xl mx-auto leading-[1.08]\">The digital twin that looks, talks, and remembers <br/><span class=\"ks-gold-text ks-serif-accent text-6xl md:text-8xl\">exactly like you.</span></h1><p class=\"text-base md:text-lg text-stone-400 max-w-2xl mx-auto font-light leading-relaxed\">Create a photorealistic 3D avatar from a single selfie, clone your voice from a 15-second WAV recording, and sync autobiographical life memories via Google Photos and pgvector.</p><div class=\"flex flex-wrap items-center justify-center gap-4 pt-2\"><a class=\"ks-button-primary text-sm px-8 py-3.5\" href=\"/dashboard\"><span>Create Your Twin Free</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"ks-button-ghost text-sm px-8 py-3.5 font-mono flex items-center gap-2\" href=\"/u/harshal\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-video w-4 h-4 text-emerald-400\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"></path><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"></rect></svg><span>Talk to Live Twin (/u/harshal)</span></a></div><div class=\"pt-6\"><div class=\"inline-flex items-center gap-3 px-4 py-2 rounded-xl bg-[#0e0c08] border border-white/[0.08] text-xs font-mono text-stone-400\"><span class=\"px-1.5 py-0.5 rounded bg-amber-400 text-black font-bold text-[10px]\">100% FREE</span><span>Runs on Oracle Cloud Always-Free (1GB RAM) + Gemini 2.0 Flash + Supabase pgvector.</span></div></div><div id=\"proof\" class=\"pt-14\"><div class=\"w-full flex flex-col items-center\"><div class=\"relative w-full max-w-5xl h-[460px] rounded-3xl overflow-hidden plinth-card select-none border border-white/10 shadow-[0_30px_90px_rgba(0,0,0,0.8)]\"><div class=\"absolute inset-0 bg-[#090806] p-8 md:p-10 flex flex-col justify-between border-r border-white/5\" style=\"width:50%;overflow:hidden\"><div class=\"w-[580px] md:w-[680px]\"><div class=\"flex items-center gap-3 mb-6\"><span class=\"proof-annotation proof-annotation--flaw\"><span class=\"w-1.5 h-1.5 rounded-full bg-red-400\"></span>Before • Generic Links &amp; AI Slop</span><span class=\"text-[11px] font-mono text-stone-500\">Traditional Personal Site</span></div><div class=\"space-y-4 max-w-md\"><div class=\"p-5 rounded-2xl bg-black/40 border border-white/5 space-y-3\"><div class=\"flex items-center gap-3\"><div class=\"w-10 h-10 rounded-full bg-stone-800 flex items-center justify-center text-stone-500 text-xs font-mono\">JPG</div><div><div class=\"text-sm font-semibold text-stone-300\">Harshal.dev/links</div><div class=\"text-[11px] text-stone-500\">Static link tree • 0 interaction</div></div></div><p class=\"text-xs text-stone-400 leading-relaxed font-sans\">Software engineer building distributed systems. Open for contracts. Check out my GitHub repo or book a meeting on my Calendly.</p><div class=\"space-y-1.5 pt-1\"><div class=\"p-2 rounded-lg bg-stone-900/60 border border-white/5 text-xs text-stone-400 flex items-center justify-between\"><span>Twitter / X</span> <span>↗</span></div><div class=\"p-2 rounded-lg bg-stone-900/60 border border-white/5 text-xs text-stone-400 flex items-center justify-between\"><span>Calendly Link</span> <span>↗</span></div></div></div><div class=\"flex items-center gap-2\"><span class=\"proof-annotation proof-annotation--flaw\">No eye contact</span><span class=\"proof-annotation proof-annotation--flaw\">Zero voice cadence</span><span class=\"proof-annotation proof-annotation--flaw\">8s bounce rate</span></div></div></div></div><div class=\"absolute inset-0 bg-[#0f0e0a] p-8 md:p-10 flex flex-col justify-between\" style=\"left:50%;width:50%;overflow:hidden\"><div class=\"w-[580px] md:w-[680px] -ml-2\"><div class=\"flex items-center gap-3 mb-6\"><span class=\"proof-annotation proof-annotation--craft\"><span class=\"w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse\"></span>After • Pavtar 3D Interactive Twin</span><span class=\"text-[11px] font-mono text-amber-300/80\">Photorealistic WebRTC Stage</span></div><div class=\"space-y-4 max-w-md\"><div class=\"p-5 rounded-2xl bg-amber-500/10 border border-amber-500/30 space-y-3 backdrop-blur-xl shadow-[0_10px_30px_rgba(212,175,55,0.15)]\"><div class=\"flex items-center justify-between\"><div class=\"flex items-center gap-2.5\"><span class=\"w-3 h-3 rounded-full bg-emerald-400 animate-ping\"></span><span class=\"text-sm font-semibold text-white\">Live 3D Twin (/u/harshal)</span></div><span class=\"px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[10px] font-mono\">Sub-450ms WebRTC</span></div><p class=\"text-xs text-amber-100/90 leading-relaxed font-sans\">Apple ARKit 52 morph targets (`jawOpen`, `mouthSmile`), real-time eye saccades tracking visitor gaze, and natural breathing idle sway.</p><div class=\"flex items-center gap-2 pt-1\"><span class=\"text-[11px] px-2 py-0.5 rounded-md bg-black/40 border border-amber-500/20 text-amber-300 font-mono\">Draco GLB &lt;2.5 MB</span><span class=\"text-[11px] px-2 py-0.5 rounded-md bg-black/40 border border-amber-500/20 text-amber-300 font-mono\">100% Free for Visitors</span></div></div><div class=\"flex items-center gap-2\"><span class=\"proof-annotation proof-annotation--craft\">Natural Eye Contact</span><span class=\"proof-annotation proof-annotation--craft\">ARKit 52 Blendshapes</span><span class=\"proof-annotation proof-annotation--craft\">Full-Duplex Speech</span></div></div></div></div><div class=\"absolute top-0 bottom-0 w-[2px] bg-gradient-to-b from-amber-200 via-amber-400 to-amber-600 shadow-[0_0_20px_rgba(212,175,55,0.9)] z-10 pointer-events-none\" style=\"left:50%\"><div class=\"absolute top-1/2 -translate-y-1/2 -left-4 w-8 h-8 rounded-full bg-[#070604] border-2 border-amber-400 flex items-center justify-center text-[10px] text-amber-300 font-mono shadow-[0_0_20px_rgba(212,175,55,0.6)]\">↔</div></div><input type=\"range\" min=\"8\" max=\"92\" class=\"proof-range-input absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-20\" aria-label=\"Slide to compare before and after\" value=\"50\"/></div><div class=\"flex flex-wrap items-center justify-center gap-2 mt-8 p-1.5 rounded-full bg-[#12100b] border border-white/10 shadow-lg\"><button class=\"px-5 py-2 rounded-full text-xs font-mono transition-all duration-200 bg-amber-400 text-black font-semibold shadow-[0_0_25px_rgba(212,175,55,0.4)]\">/presence</button><button class=\"px-5 py-2 rounded-full text-xs font-mono transition-all duration-200 text-stone-400 hover:text-stone-200 hover:bg-white/5\">/voice</button><button class=\"px-5 py-2 rounded-full text-xs font-mono transition-all duration-200 text-stone-400 hover:text-stone-200 hover:bg-white/5\">/memory</button><button class=\"px-5 py-2 rounded-full text-xs font-mono transition-all duration-200 text-stone-400 hover:text-stone-200 hover:bg-white/5\">/channels</button></div></div></div></div></section><section class=\"py-16 border-y border-white/[0.06] bg-[#050403] overflow-hidden\"><div class=\"max-w-7xl mx-auto px-6 mb-8 text-center\"><span class=\"text-[11px] font-mono uppercase tracking-widest text-amber-400/80\">/community-proof • Trusted by creators &amp; engineers worldwide</span></div><div class=\"relative w-full overflow-hidden\"><div class=\"animate-marquee flex gap-6 px-6\"><div class=\"w-[380px] p-6 rounded-2xl plinth-card flex flex-col justify-between space-y-4 shrink-0\"><p class=\"text-xs text-stone-300 leading-relaxed font-sans italic\">&quot;<!-- -->My digital twin booked 4 consulting calls while I was asleep on a 14-hour flight. It feels like magic.<!-- -->&quot;</p><div class=\"flex items-center justify-between pt-2 border-t border-white/5 text-xs\"><div><div class=\"font-semibold text-white\">Alex Rivera</div><div class=\"text-[11px] font-mono text-stone-500\">@alexrivera_ai</div></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-amber-300\">Founder &amp; Creator</span></div></div><div class=\"w-[380px] p-6 rounded-2xl plinth-card flex flex-col justify-between space-y-4 shrink-0\"><p class=\"text-xs text-stone-300 leading-relaxed font-sans italic\">&quot;<!-- -->Having my voice cloned from just a 15-second WAV and speaking over WebRTC in under 450ms is unmatched.<!-- -->&quot;</p><div class=\"flex items-center justify-between pt-2 border-t border-white/5 text-xs\"><div><div class=\"font-semibold text-white\">Elena Rostova</div><div class=\"text-[11px] font-mono text-stone-500\">@erostova_dev</div></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-amber-300\">Systems Architect</span></div></div><div class=\"w-[380px] p-6 rounded-2xl plinth-card flex flex-col justify-between space-y-4 shrink-0\"><p class=\"text-xs text-stone-300 leading-relaxed font-sans italic\">&quot;<!-- -->The Google Photos memory integration is wild. It answered questions about my Tokyo trip and showed the exact photos.<!-- -->&quot;</p><div class=\"flex items-center justify-between pt-2 border-t border-white/5 text-xs\"><div><div class=\"font-semibold text-white\">Marcus Chen</div><div class=\"text-[11px] font-mono text-stone-500\">@marcus_c</div></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-amber-300\">Tech Evangelist</span></div></div><div class=\"w-[380px] p-6 rounded-2xl plinth-card flex flex-col justify-between space-y-4 shrink-0\"><p class=\"text-xs text-stone-300 leading-relaxed font-sans italic\">&quot;<!-- -->The 100% free Oracle Always-Free + Gemini 2.0 Flash stack makes it a no-brainer. Zero cloud bills.<!-- -->&quot;</p><div class=\"flex items-center justify-between pt-2 border-t border-white/5 text-xs\"><div><div class=\"font-semibold text-white\">David Kim</div><div class=\"text-[11px] font-mono text-stone-500\">@dkim_builds</div></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-amber-300\">Open Source Builder</span></div></div><div class=\"w-[380px] p-6 rounded-2xl plinth-card flex flex-col justify-between space-y-4 shrink-0\"><p class=\"text-xs text-stone-300 leading-relaxed font-sans italic\">&quot;<!-- -->My digital twin booked 4 consulting calls while I was asleep on a 14-hour flight. It feels like magic.<!-- -->&quot;</p><div class=\"flex items-center justify-between pt-2 border-t border-white/5 text-xs\"><div><div class=\"font-semibold text-white\">Alex Rivera</div><div class=\"text-[11px] font-mono text-stone-500\">@alexrivera_ai</div></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-amber-300\">Founder &amp; Creator</span></div></div><div class=\"w-[380px] p-6 rounded-2xl plinth-card flex flex-col justify-between space-y-4 shrink-0\"><p class=\"text-xs text-stone-300 leading-relaxed font-sans italic\">&quot;<!-- -->Having my voice cloned from just a 15-second WAV and speaking over WebRTC in under 450ms is unmatched.<!-- -->&quot;</p><div class=\"flex items-center justify-between pt-2 border-t border-white/5 text-xs\"><div><div class=\"font-semibold text-white\">Elena Rostova</div><div class=\"text-[11px] font-mono text-stone-500\">@erostova_dev</div></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-amber-300\">Systems Architect</span></div></div><div class=\"w-[380px] p-6 rounded-2xl plinth-card flex flex-col justify-between space-y-4 shrink-0\"><p class=\"text-xs text-stone-300 leading-relaxed font-sans italic\">&quot;<!-- -->The Google Photos memory integration is wild. It answered questions about my Tokyo trip and showed the exact photos.<!-- -->&quot;</p><div class=\"flex items-center justify-between pt-2 border-t border-white/5 text-xs\"><div><div class=\"font-semibold text-white\">Marcus Chen</div><div class=\"text-[11px] font-mono text-stone-500\">@marcus_c</div></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-amber-300\">Tech Evangelist</span></div></div><div class=\"w-[380px] p-6 rounded-2xl plinth-card flex flex-col justify-between space-y-4 shrink-0\"><p class=\"text-xs text-stone-300 leading-relaxed font-sans italic\">&quot;<!-- -->The 100% free Oracle Always-Free + Gemini 2.0 Flash stack makes it a no-brainer. Zero cloud bills.<!-- -->&quot;</p><div class=\"flex items-center justify-between pt-2 border-t border-white/5 text-xs\"><div><div class=\"font-semibold text-white\">David Kim</div><div class=\"text-[11px] font-mono text-stone-500\">@dkim_builds</div></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-amber-300\">Open Source Builder</span></div></div></div></div></section><section id=\"avatar-engine\" class=\"py-24 px-6 border-b border-white/[0.06]\"><div class=\"max-w-6xl mx-auto grid lg:grid-cols-12 gap-12 items-center\"><div class=\"lg:col-span-6 space-y-6\"><div class=\"inline-flex items-center gap-2 text-xs font-mono text-amber-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layers w-4 h-4\"><path d=\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z\"></path><path d=\"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12\"></path><path d=\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\"></path></svg><span>/subsystem-01 • 3D Avatar &amp; ARKit Rigging</span></div><h2 class=\"text-3xl md:text-5xl font-bold tracking-tight text-white leading-tight\">Photorealistic avatar. <br/><span class=\"ks-gold-text\">52 Apple ARKit blendshapes.</span></h2><p class=\"text-sm text-stone-400 leading-relaxed font-light\">We leverage Avaturn.me to construct a rigged 3D full-body mesh from a single selfie. The Three.js stage smoothly interpolates eye gaze to follow cursor movement, randomized double-blinking, and dynamic emotional morph targets.</p><div class=\"grid grid-cols-2 gap-4 pt-2\"><div class=\"p-4 rounded-xl plinth-interactive space-y-1\"><div class=\"text-sm font-semibold text-amber-200\">ARKit 52 Rig</div><p class=\"text-[11px] text-stone-400\">Lip sync visemes + emotional expressions (`jawOpen`, `mouthSmile`).</p></div><div class=\"p-4 rounded-xl plinth-interactive space-y-1\"><div class=\"text-sm font-semibold text-amber-200\">Draco Compressed</div><p class=\"text-[11px] text-stone-400\">Optimized GLB meshes under 2.5 MB for instant mobile loading.</p></div></div></div><div class=\"lg:col-span-6\"><div class=\"p-8 rounded-3xl plinth-card space-y-6 bg-gradient-to-b from-[#110f0b] to-[#070604]\"><div class=\"flex items-center justify-between border-b border-white/10 pb-4\"><span class=\"text-xs font-mono text-stone-400\">Active Morph Target Stream</span><span class=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300\">60 FPS WebGL</span></div><div class=\"space-y-3 font-mono text-xs\"><div><div class=\"flex justify-between text-stone-300 mb-1\"><span>jawOpen (Speech Energy)</span><span class=\"text-amber-400\">0.82</span></div><div class=\"h-1.5 w-full bg-stone-800 rounded-full overflow-hidden\"><div class=\"h-full bg-amber-400 w-[82%]\"></div></div></div><div><div class=\"flex justify-between text-stone-300 mb-1\"><span>mouthSmileRight (Mood: Warm)</span><span class=\"text-amber-400\">0.65</span></div><div class=\"h-1.5 w-full bg-stone-800 rounded-full overflow-hidden\"><div class=\"h-full bg-amber-400 w-[65%]\"></div></div></div><div><div class=\"flex justify-between text-stone-300 mb-1\"><span>eyeBlinkLeft / Right (Perlin Noise)</span><span class=\"text-amber-400\">0.10</span></div><div class=\"h-1.5 w-full bg-stone-800 rounded-full overflow-hidden\"><div class=\"h-full bg-amber-400 w-[10%]\"></div></div></div></div><div class=\"p-4 rounded-xl bg-black/40 border border-white/5 text-xs text-stone-300 flex items-center justify-between\"><span class=\"flex items-center gap-2\"><span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span><span>TalkingHead Three.js Renderer</span></span><a class=\"text-amber-300 hover:underline flex items-center gap-1\" href=\"/u/harshal\"><span>Test in 3D</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link w-3 h-3\"><path d=\"M15 3h6v6\"></path><path d=\"M10 14 21 3\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path></svg></a></div></div></div></div></section><section id=\"voice-lab\" class=\"py-24 px-6 border-b border-white/[0.06] bg-[#090806]\"><div class=\"max-w-6xl mx-auto grid lg:grid-cols-12 gap-12 items-center\"><div class=\"lg:col-span-6 order-2 lg:order-1\"><div class=\"p-8 rounded-3xl plinth-card space-y-6 bg-gradient-to-b from-[#12100b] to-[#080705]\"><div class=\"flex items-center justify-between border-b border-white/10 pb-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mic w-4 h-4 text-amber-400\"><path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z\"></path><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"></path><line x1=\"12\" x2=\"12\" y1=\"19\" y2=\"22\"></line></svg><span class=\"text-xs font-mono text-white\">Voice Calibration Sample (WAV)</span></div><span class=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300\">44.1 kHz PCM</span></div><div class=\"h-20 flex items-center gap-1 p-3 rounded-2xl bg-black/50 border border-white/5\"><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:30%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:60%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:90%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:45%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:80%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:100%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:65%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:85%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:40%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:95%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:70%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:50%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:85%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:100%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:60%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:40%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:75%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:90%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:65%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:30%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:80%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:55%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:95%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:70%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:40%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:85%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:60%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:100%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:45%\"></div><div class=\"flex-1 bg-gradient-to-t from-amber-500 to-amber-200 rounded-full transition-all duration-300\" style=\"height:80%\"></div></div><div class=\"grid grid-cols-3 gap-3 text-center text-xs font-mono\"><div class=\"p-3 rounded-xl bg-white/5 border border-white/5\"><div class=\"text-stone-400 text-[10px]\">DURATION</div><div class=\"text-white font-semibold mt-1\">15.2s</div></div><div class=\"p-3 rounded-xl bg-white/5 border border-white/5\"><div class=\"text-stone-400 text-[10px]\">ROUND TRIP</div><div class=\"text-emerald-400 font-semibold mt-1\">&lt;450ms</div></div><div class=\"p-3 rounded-xl bg-white/5 border border-white/5\"><div class=\"text-stone-400 text-[10px]\">CLOUD COST</div><div class=\"text-amber-300 font-semibold mt-1\">$0.00</div></div></div></div></div><div class=\"lg:col-span-6 order-1 lg:order-2 space-y-6\"><div class=\"inline-flex items-center gap-2 text-xs font-mono text-amber-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mic w-4 h-4\"><path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z\"></path><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"></path><line x1=\"12\" x2=\"12\" y1=\"19\" y2=\"22\"></line></svg><span>/subsystem-02 • Zero-Cost Neural Voice Engine</span></div><h2 class=\"text-3xl md:text-5xl font-bold tracking-tight text-white leading-tight\">Calibrated in 15 seconds. <br/><span class=\"ks-gold-text\">Streamed in milliseconds.</span></h2><p class=\"text-sm text-stone-400 leading-relaxed font-light\">Record a 15-second speech sample directly in your browser. We extract your vocal resonance and cadence to synthesize streaming neural speech via Edge-TTS and Kokoro latents without paying expensive commercial voice APIs.</p><div class=\"space-y-3 pt-2\"><div class=\"flex items-center gap-3 text-xs text-stone-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-emerald-400 shrink-0\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Pipelined punctuation chunking for sub-120ms first-audio token</span></div><div class=\"flex items-center gap-3 text-xs text-stone-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-emerald-400 shrink-0\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Silero VAD barge-in for natural conversational interruptions</span></div><div class=\"flex items-center gap-3 text-xs text-stone-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-emerald-400 shrink-0\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Multilingual support across 40+ languages in your cloned tone</span></div></div></div></div></section><section id=\"omnichannel\" class=\"py-24 px-6 border-b border-white/[0.06]\"><div class=\"max-w-5xl mx-auto space-y-16\"><div class=\"text-center space-y-4\"><div class=\"inline-flex items-center gap-2 text-xs font-mono text-amber-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bot w-4 h-4\"><path d=\"M12 8V4H8\"></path><rect width=\"16\" height=\"12\" x=\"4\" y=\"8\" rx=\"2\"></rect><path d=\"M2 14h2\"></path><path d=\"M20 14h2\"></path><path d=\"M15 13v2\"></path><path d=\"M9 13v2\"></path></svg><span>/subsystem-03 • Unified Omnichannel Router</span></div><h2 class=\"text-3xl md:text-5xl font-bold tracking-tight text-white\">One brain. Every messaging channel.</h2><p class=\"text-sm text-stone-400 max-w-xl mx-auto font-light\">Your digital twin autonomously answers inquiries on your behalf while keeping you in the loop with live VIP takeover alerts.</p></div><div class=\"grid md:grid-cols-3 gap-6\"><div class=\"p-6 rounded-2xl plinth-card space-y-4\"><div class=\"flex items-center justify-between\"><span class=\"text-sm font-semibold text-white flex items-center gap-2\"><span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span> Telegram</span><span class=\"text-[10px] font-mono text-stone-400\">Voice Notes + VIP</span></div><p class=\"text-xs text-stone-400 leading-relaxed\">Accepts incoming voice notes on Telegram, transcribes them with Groq Whisper, and replies with synthesized audio voice messages.</p></div><div class=\"p-6 rounded-2xl plinth-card space-y-4\"><div class=\"flex items-center justify-between\"><span class=\"text-sm font-semibold text-white flex items-center gap-2\"><span class=\"w-2 h-2 rounded-full bg-amber-400\"></span> WhatsApp</span><span class=\"text-[10px] font-mono text-stone-400\">Meta Cloud API</span></div><p class=\"text-xs text-stone-400 leading-relaxed\">1,000 free conversations/month to automatically handle customer, client, or recruiter inquiries on WhatsApp.</p></div><div class=\"p-6 rounded-2xl plinth-card space-y-4\"><div class=\"flex items-center justify-between\"><span class=\"text-sm font-semibold text-white flex items-center gap-2\"><span class=\"w-2 h-2 rounded-full bg-sky-400\"></span> Web Widget</span><span class=\"text-[10px] font-mono text-stone-400\">&lt;script /&gt;</span></div><p class=\"text-xs text-stone-400 leading-relaxed\">Embed your interactive 3D digital twin on your portfolio or company website with a single JavaScript script tag.</p></div></div></div></section><section class=\"py-24 px-6 bg-[#090806]\"><div class=\"max-w-4xl mx-auto space-y-12\"><div class=\"text-center space-y-3\"><span class=\"text-xs font-mono uppercase tracking-widest text-amber-400\">/manifesto • The $0 Cloud Stack</span><h2 class=\"text-3xl md:text-4xl font-bold tracking-tight text-white\">Why pay $500/mo when the best tools are free?</h2><p class=\"text-xs text-stone-400 max-w-lg mx-auto\">Pavtar is engineered to maximize generous free tiers without ever hitting billing walls.</p></div><div class=\"p-8 rounded-3xl plinth-card space-y-6\"><div class=\"grid sm:grid-cols-2 gap-4 text-xs font-mono\"><div class=\"p-4 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between\"><span class=\"text-stone-300\">Oracle Always-Free VM (1GB RAM)</span><span class=\"text-emerald-400 font-bold\">$0.00 / mo</span></div><div class=\"p-4 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between\"><span class=\"text-stone-300\">Google Gemini 2.0 Flash (1M TPM)</span><span class=\"text-emerald-400 font-bold\">$0.00 / mo</span></div><div class=\"p-4 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between\"><span class=\"text-stone-300\">Groq Whisper Turbo STT API</span><span class=\"text-emerald-400 font-bold\">$0.00 / mo</span></div><div class=\"p-4 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between\"><span class=\"text-stone-300\">Edge-TTS &amp; Kokoro Audio</span><span class=\"text-emerald-400 font-bold\">$0.00 / mo</span></div><div class=\"p-4 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between\"><span class=\"text-stone-300\">Supabase / Neon PostgreSQL pgvector</span><span class=\"text-emerald-400 font-bold\">$0.00 / mo</span></div><div class=\"p-4 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between\"><span class=\"text-stone-300\">Cloudflare R2 (10 GB Zero-Egress)</span><span class=\"text-emerald-400 font-bold\">$0.00 / mo</span></div></div><div class=\"p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex flex-col sm:flex-row items-center justify-between gap-4\"><div><div class