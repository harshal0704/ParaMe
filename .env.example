# ==============================================================================
# OMNICHANNEL AI PERSONA & 3D DIGITAL TWIN PLATFORM CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_DEPLOY_MODE=platform # 'platform' for /u/[username] multi-user SaaS, or 'self_hosted'
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# 1. 24/7 Permanent PostgreSQL DB with pgvector (Self-hosted on Oracle VM via Docker)
# Zero external database accounts required. Never shuts down or sleeps!
POSTGRES_DB=parame
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_123@db:5432/parame

# 2. Clerk Authentication (Free Tier - 10,000 Monthly Active Users)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/onboarding

# 3. LiveKit WebRTC Configuration (Self-Hosted on Oracle VM)
LIVEKIT_URL=ws://livekit:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret98765432101234567890abcdef

# 4. AI & Speech Reasoning Core ($0 Free Tiers)
GEMINI_API_KEY=your_gemini_api_key_here # Google AI Studio: Free 15 RPM / 1M TPM
GROQ_API_KEY=your_groq_api_key_here     # Groq API: Free Whisper Turbo & Llama 3.3

# 5. Zero-Egress Cloudflare R2 Asset & Voice Storage (10 GB Free Storage)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=persona-assets
R2_PUBLIC_DOMAIN=https://assets.yourtwin.domain

# 6. Omnichannel Ingestion Integrations (Optional)
# Telegram Bot API (100% Free, Unlimited)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_personal_telegram_chat_id # For 1-click VIP live human takeover

# WhatsApp Meta Cloud API (1,000 Free Conversations/Month)
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_secret

# Discord Bot (Optional)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_PUBLIC_KEY=your_discord_application_public_key

# Resend Email (Optional)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=twin@parame.harshalsp.com

# Cal.com & Spotify Tools
CAL_COM_API_KEY=your_cal_com_api_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
